{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/historia.html",
      "destination": "/sobre/",
      "permanent": true
    },
    {
      "source": "/modalidades.html",
      "destination": "/modalidades/",
      "permanent": true
    },
    {
      "source": "/horarios.html",
      "destination": "/horarios/",
      "permanent": true
    },
    {
      "source": "/planos.html",
      "destination": "/planos/",
      "permanent": true
    },
    {
      "source": "/contato.html",
      "destination": "/contato/",
      "permanent": true
    }
  ]
}
